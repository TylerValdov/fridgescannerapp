<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Copy this file to Secrets.plist (gitignored) in the same folder and paste
  your key from https://spoonacular.com/food-api/console. Without it, the app
  uses the bundled demo recipes.
-->
<plist version="1.0">
<dict>
	<key>SpoonacularAPIKey</key>
	<string>YOUR_SPOONACULAR_API_KEY</string>
</dict>
</plist>
